{
  "name": "@sudobility/characterbuilder_ui",
  "version": "0.0.2",
  "description": "Reusable CharacterBuilder UI: FaceSpec editor, trait-icon art, portrait/variation panels, localized routing helpers",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:watch"
  },
  "peerDependencies": {
    "@sudobility/building_blocks": "^0.0.380",
    "@sudobility/characterbuilder_client": "^0.1.20",
    "@sudobility/characterbuilder_lib": "^0.1.17",
    "@sudobility/characterbuilder_types": "^0.1.16",
    "@sudobility/components": "^5.3.71",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=7.0.0"
  },
  "devDependencies": {
    "@sudobility/building_blocks": "^0.0.380",
    "@sudobility/characterbuilder_client": "^0.1.20",
    "@sudobility/characterbuilder_lib": "^0.1.17",
    "@sudobility/characterbuilder_types": "^0.1.16",
    "@sudobility/components": "^5.3.71",
    "@tanstack/react-query": "~5.104.5",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "class-variance-authority": "~0.7.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-router-dom": "~7.18.4",
    "typescript": "~6.0.3"
  },
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/characterbuilder_ui.git"
  }
}
